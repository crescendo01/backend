# Copy this file to .env for local development (`cp .env.example .env`).
# On Render, set these under your service's "Environment" tab instead —
# do not commit a real .env file.

# ----------------------------------------------------------------------------
# Firebase Admin — required. Used to verify every request's ID token, so
# the backend knows which user is calling (this is the access-control
# layer now — Supabase RLS is no longer load-bearing for normal traffic).
# Get this file from:
#   Firebase Console -> Project Settings -> Service Accounts
#   -> Generate new private key
#
# Provide ONE of the two below. Base64 is recommended on Render (no
# special characters to get mangled by the dashboard's env var editor):
#   base64 -i service-account.json | tr -d '\n'
# then paste the single resulting line as FIREBASE_SERVICE_ACCOUNT_JSON_BASE64.
# ----------------------------------------------------------------------------
FIREBASE_SERVICE_ACCOUNT_JSON_BASE64=
# FIREBASE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# Optional extra sanity check; if omitted, it's read from the service
# account JSON's own project_id field. For this project: crescendo-xd
FIREBASE_PROJECT_ID=crescendo-xd

# ----------------------------------------------------------------------------
# Supabase — required. The backend is now the *only* thing that talks to
# Supabase; the Flutter app holds no Supabase key at all. Use the
# service_role key deliberately — it bypasses RLS, and these route
# handlers are the access control now. Get both from:
#   Supabase Studio -> Project Settings -> API
# ----------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=recordings

# ----------------------------------------------------------------------------
# Gemini — optional. Without it, /v1/feedback/generate always returns the
# same graceful fallback templates the Flutter app already used when no
# key was configured, so the feature degrades, it doesn't break.
# Get a key from https://aistudio.google.com/app/apikey
# ----------------------------------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# ----------------------------------------------------------------------------
# CORS — comma-separated list of allowed web origins. Only matters for the
# Flutter *web* build (mobile/desktop builds don't send an Origin header).
# Leave as "*" while developing; lock it down before shipping, e.g.:
# ALLOWED_ORIGINS=https://crescendo-xd.web.app,https://crescendo.app
# ----------------------------------------------------------------------------
ALLOWED_ORIGINS=*

# ----------------------------------------------------------------------------
# Realtime — how often (seconds) the backend re-checks Postgres for an
# actively-watched leaderboard/profile. Lower = snappier pushes, more load
# on your database. See app/realtime.py for what this actually means.
# ----------------------------------------------------------------------------
REALTIME_POLL_INTERVAL_SECONDS=2.0

# ----------------------------------------------------------------------------
# Misc
# ----------------------------------------------------------------------------
ENVIRONMENT=development
LOG_LEVEL=INFO
RATE_LIMIT_FEEDBACK_PER_MINUTE=30
